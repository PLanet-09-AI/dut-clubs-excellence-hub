# ─── Email Templates Configuration ────────────────────────────────────────
# Required for sending reminder and shortlist notification emails

# Your EmailJS Public Key (from emailjs.com Account → API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Service ID (from emailjs.com Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# ───────────────────────────────────────────────────────────────────────────
# Template 1: Nominee Reminder (Missing Documents)
# ───────────────────────────────────────────────────────────────────────────
# Used by: send-nominee-reminder Netlify function
# Purpose: Send reminders to nominees with incomplete nominations
# Variables: to_email, nominator_name, nominee_name, category_name, 
#            incomplete_items_html (raw HTML), submission_url, current_year
# Email Format: HTML
VITE_EMAILJS_TEMPLATE_ID=your_reminder_template_id_here

# ───────────────────────────────────────────────────────────────────────────
# Template 2: Shortlist Notification (Congratulations)
# ───────────────────────────────────────────────────────────────────────────
# Used by: send-shortlist-email Netlify function
# Purpose: Send congratulations to nominees who have been shortlisted
# Variables: to_email, nominee_name, nominator_name, category_name, 
#            submission_url, current_year
# Email Format: HTML
VITE_EMAILJS_SHORTLIST_TEMPLATE_ID=your_shortlist_template_id_here

# Your EmailJS Private Key (for Netlify Functions - Server-side only)
# ⚠️  DO NOT commit this to version control!
# Store in Netlify environment variables: Site Settings → Build & Deploy → Environment
EMAILJS_PRIVATE_KEY=your_private_key_here
